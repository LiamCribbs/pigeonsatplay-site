source "https://rubygems.org"

# Matches the Jekyll version and plugins GitHub Pages uses, so local previews
# (bundle exec jekyll serve) look the same as the live site.
gem "github-pages", group: :jekyll_plugins
gem "webrick"

# Windows needs timezone data bundled separately.
platforms :mingw, :x64_mingw, :mswin do
  gem "tzinfo-data"
end
